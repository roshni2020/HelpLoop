# ─────────────────────────────────────────────────────────────
# HelpLoop environment
# Copy to .env.local and fill in what you have.
# EVERY key is optional — HelpLoop degrades to a fully working
# demo mode when a key is missing, so the demo never dies on stage.
# ─────────────────────────────────────────────────────────────

# ── Track 1: Linkup (deep research over real community resources)
# Get one at https://app.linkup.so
LINKUP_API_KEY=
# "standard" is fast + cheap, "deep" is slower + more thorough.
LINKUP_DEPTH=standard

# ── Track 2: Nebius Token Factory (resource ranking model)
# Key: https://tokenfactory.nebius.com  ->  OpenAI-compatible endpoint.
# Kept server-side only: no NEXT_PUBLIC_ prefix, so it is never sent to
# the browser. All model calls go through /api/research on the server.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# `npm run models` lists what your account can actually call.
NEBIUS_MODEL=openai/gpt-oss-120b
# Used only for the cost column of the eval report (USD per 1M tokens).
NEBIUS_PRICE_IN_PER_M=0.13
NEBIUS_PRICE_OUT_PER_M=0.40

# ── Track 3: Convex (realtime coordination)
# Run `npx convex dev` once; it writes this value for you.
# Leave blank to use the built-in local realtime shim (syncs across
# tabs/windows on one machine — enough for a live two-browser demo).
NEXT_PUBLIC_CONVEX_URL=
# Optional: push from CI or a non-interactive shell instead of `npx convex dev`.
CONVEX_DEPLOY_KEY=

# ── Track 4: Map
# Optional. Blank = free CARTO basemap, no account needed.
NEXT_PUBLIC_MAP_STYLE=
